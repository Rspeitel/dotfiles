;; Begin Workspaces

(deflisten active_workspace :inital "" "./scripts/workspace.sh --workspaces")

(defwidget workspaces []
  (box
    :class "works"
    :orientation "h"
    :space-evenly false
    (workspaceicon :active_ws active_workspace :ws 1)
    (workspaceicon :active_ws active_workspace :ws 2)
    (workspaceicon :active_ws active_workspace :ws 3)
    (workspaceicon :active_ws active_workspace :ws 4)
    (workspaceicon :active_ws active_workspace :ws 5)
  )
)

(defwidget workspaceicon [active_ws ws]
  (button
    :onclick "./scripts/workspace.sh --change-workspace ${ws}"
    (image :path "icons/${active_ws == ws ? 'filled-circle' : 'hollow-circle'}.svg")
  )
)
;; End Workspaces
